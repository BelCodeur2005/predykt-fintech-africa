    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "POST Login Admin Cabinet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('Access token is present', function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.accessToken).to.have.lengthOf.above(50);",
                  "});",
                  "",
                  "// Sauvegarder les tokens",
                  "pm.environment.set('access_token', jsonData.accessToken);",
                  "pm.environment.set('refresh_token', jsonData.refreshToken);",
                  "pm.environment.set('user_id', jsonData.userId);",
                  "",
                  "console.log('✅ Access token saved');",
                  "",
                  "pm.test('User has ROLE_ADMIN_CABINET', function () {",
                  "    pm.expect(jsonData.roles).to.include('ROLE_ADMIN_CABINET');",
                  "});",
                  "",
                  "// Décoder le JWT pour vérifier cabinetId",
                  "var token = jsonData.accessToken;",
                  "var base64Url = token.split('.')[1];",
                  "var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
                  "var jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {",
                  "    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);",
                  "}).join(''));",
                  "",
                  "var payload = JSON.parse(jsonPayload);",
                  "console.log('📄 JWT Payload:', payload);",
                  "",
                  "pm.test('JWT contains cabinetId', function () {",
                  "    pm.expect(payload.cabinetId).to.exist;",
                  "    pm.expect(payload.cabinetId).to.equal(1);",
                  "});",
                  "",
                  "pm.test('JWT contains companyId', function () {",
                  "    pm.expect(payload.companyId).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login admin cabinet - retourne JWT avec cabinetId"
          }
        },
        {
          "name": "POST Register Collaborateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('User has ROLE_COLLABORATOR', function () {",
                  "    pm.expect(jsonData.roles).to.include('ROLE_COLLABORATOR');",
                  "});",
                  "",
                  "pm.environment.set('collaborator_id', jsonData.userId);",
                  "pm.environment.set('collaborator_token', jsonData.accessToken);",
                  "",
                  "var token = jsonData.accessToken;",
                  "var base64Url = token.split('.')[1];",
                  "var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
                  "var jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {",
                  "    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);",
                  "}).join(''));",
                  "",
                  "var payload = JSON.parse(jsonPayload);",
                  "",
                  "pm.test('JWT contains cabinetId', function () {",
                  "    pm.expect(payload.cabinetId).to.equal(1);",
                  "});",
                  "",
                  "pm.test('JWT contains companyId for Entreprise B', function () {",
                  "    pm.expect(payload.companyId).to.equal(11);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_user_email}}\",\n  \"password\": \"Collab@123\",\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Dupont\",\n  \"phone\": \"+237 690 123 456\",\n  \"companyId\": {{company_id_B}},\n  \"cabinetId\": {{cabinet_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Créer un collaborateur affecté au dossier Entreprise B"
          }
        },
        {
          "name": "POST Login Collaborateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('collaborator_token', jsonData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_user_email}}\",\n  \"password\": \"Collab@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "POST Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('New access token received', function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "});",
                  "",
                  "pm.environment.set('access_token', jsonData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Companies Management (Dossiers)",
      "item": [
        {
          "name": "GET All Companies (Cabinet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('Response has data array', function () {",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Cabinet has exactly 3 companies', function () {",
                  "    pm.expect(jsonData.data).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test('All companies belong to cabinet 1', function () {",
                  "    jsonData.data.forEach(function(company) {",
                  "        pm.expect(company.cabinetId).to.equal(1);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Company names are correct', function () {",
                  "    var names = jsonData.data.map(c => c.name);",
                  "    pm.expect(names).to.include('Entreprise A SARL');",
                  "    pm.expect(names).to.include('Entreprise B SA');",
                  "    pm.expect(names).to.include('Entreprise C SAS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies",
              "host": ["{{base_url}}"],
              "path": ["companies"]
            },
            "description": "Liste tous les dossiers du cabinet"
          }
        },
        {
          "name": "GET Company Details (Entreprise A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('Company belongs to cabinet', function () {",
                  "    pm.expect(jsonData.data.cabinetId).to.equal(1);",
                  "});",
                  "",
                  "pm.test('Company uses OHADA standard', function () {",
                  "    pm.expect(jsonData.data.accountingStandard).to.equal('OHADA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies/{{company_id_A}}",
              "host": ["{{base_url}}"],
              "path": ["companies", "{{company_id_A}}"]
            }
          }
        },
        {
          "name": "GET Company (Collaborateur - Dossier Autorisé)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 (Access granted)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('Company ID is 11 (Entreprise B)', function () {",
                  "    pm.expect(jsonData.data.id).to.equal(11);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collaborator_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies/{{company_id_B}}",
              "host": ["{{base_url}}"],
              "path": ["companies", "{{company_id_B}}"]
            },
            "description": "Collaborateur accède à un dossier qui lui est affecté"
          }
        },
        {
          "name": "GET Company (Collaborateur - Dossier NON Autorisé)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Access denied to non-assigned company', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.equal('Forbidden');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collaborator_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies/{{company_id_A}}",
              "host": ["{{base_url}}"],
              "path": ["companies", "{{company_id_A}}"]
            },
            "description": "Test isolation - doit retourner 403"
          }
        }
      ]
    },
    {
      "name": "07 - General Ledger (Comptabilité)",
      "item": [
        {
          "name": "POST Create Balanced Entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('Entry is balanced', function () {",
                  "    pm.expect(jsonData.data.isBalanced).to.be.true;",
                  "    pm.expect(jsonData.data.totalDebit).to.equal(jsonData.data.totalCredit);",
                  "});",
                  "",
                  "pm.test('Entry has 3 lines', function () {",
                  "    pm.expect(jsonData.data.entries).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.environment.set('entry_id', jsonData.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": {{company_id_A}},\n  \"entryDate\": \"2025-01-15\",\n  \"description\": \"Vente de marchandises - Facture #2025-001\",\n  \"journalCode\": \"VE\",\n  \"reference\": \"FAC-2025-001\",\n  \"entries\": [\n    {\n      \"accountNumber\": \"411100\",\n      \"accountName\": \"Clients\",\n      \"debit\": 1180000,\n      \"credit\": 0,\n      \"description\": \"Client ABC\"\n    },\n    {\n      \"accountNumber\": \"701100\",\n      \"accountName\": \"Ventes de marchandises\",\n      \"debit\": 0,\n      \"credit\": 1000000,\n      \"description\": \"Vente marchandises\"\n    },\n    {\n      \"accountNumber\": \"443100\",\n      \"accountName\": \"TVA collectée\",\n      \"debit\": 0,\n      \"credit\": 180000,\n      \"description\": \"TVA 18%\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/general-ledger",
              "host": ["{{base_url}}"],
              "path": ["general-ledger"]
            },
            "description": "Créer une écriture équilibrée (débit = crédit)"
          }
        },
        {
          "name": "POST Create Unbalanced Entry (Should Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message mentions unbalanced', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message.toLowerCase()).to.include('déséquilibr');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": {{company_id_A}},\n  \"entryDate\": \"2025-01-15\",\n  \"description\": \"Écriture déséquilibrée (TEST)\",\n  \"journalCode\": \"OD\",\n  \"entries\": [\n    {\n      \"accountNumber\": \"411100\",\n      \"debit\": 1000000,\n      \"credit\": 0\n    },\n    {\n      \"accountNumber\": \"701100\",\n      \"debit\": 0,\n      \"credit\": 500000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/general-ledger",
              "host": ["{{base_url}}"],
              "path": ["general-ledger"]
            },
            "description": "Test validation - doit retourner 400"
          }
        }
      ]
    },
    {
      "name": "08 - Financial Reports",
      "item": [
        {
          "name": "GET Balance Sheet (Bilan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('Balance sheet is balanced', function () {",
                  "    pm.expect(jsonData.data.isBalanced).to.be.true;",
                  "    pm.expect(jsonData.data.assets.totalAssets)",
                  "      .to.equal(jsonData.data.liabilitiesAndEquity.totalLiabilitiesAndEquity);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies/{{company_id_A}}/reports/balance-sheet?asOfDate=2025-01-31",
              "host": ["{{base_url}}"],
              "path": ["companies", "{{company_id_A}}", "reports", "balance-sheet"],
              "query": [
                {
                  "key": "asOfDate",
                  "value": "2025-01-31"
                }
              ]
            },
            "description": "Générer le bilan comptable"
          }
        }
      ]
    },
    {
      "name": "09 - Financial Ratios",
      "item": [
        {
          "name": "POST Calculate Ratios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test('All ratio categories present', function () {",
                  "    pm.expect(jsonData.data).to.have.property('profitabilityRatios');",
                  "    pm.expect(jsonData.data).to.have.property('liquidityRatios');",
                  "    pm.expect(jsonData.data).to.have.property('activityRatios');",
                  "    pm.expect(jsonData.data).to.have.property('solvencyRatios');",
                  "});",
                  "",
                  "pm.test('ROA is a valid percentage', function () {",
                  "    var roa = jsonData.data.profitabilityRatios.roa;",
                  "    pm.expect(roa).to.be.a('number');",
                  "    pm.expect(roa).to.be.at.least(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/companies/{{company_id_A}}/ratios/calculate?startDate=2025-01-01&endDate=2025-01-31",
              "host": ["{{base_url}}"],
              "path": ["companies", "{{company_id_A}}", "ratios", "calculate"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2025-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2025-01-31"
                }
              ]
            },
            "description": "Calculer les 20+ ratios financiers"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    }
  ]
}
